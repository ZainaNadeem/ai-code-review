# Copy to .env and fill in real values. Do NOT commit .env.
# This single root .env is consumed by docker-compose: the postgres service
# reads POSTGRES_*, and every variable below is passed through to the server.

# ---------- PostgreSQL ----------
POSTGRES_DB=ai_code_review
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password

# DATABASE_URL is constructed automatically by docker-compose from the
# POSTGRES_* values above (host = the "postgres" service). Only set this if you
# run the server outside Docker, e.g.:
# DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/ai_code_review

# ---------- App ----------
APP_ENV=development
LOG_LEVEL=info

# ---------- OpenAI (review pipeline + embeddings) ----------
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# ---------- GitHub ----------
# Shared secret configured on the GitHub webhook (used for HMAC-SHA256 checks).
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret
# Personal access token used to fetch PR diffs (needs repo / pull-request read).
GITHUB_TOKEN=ghp-your-github-token

# ---------- Auth (JWT) ----------
# Generate a strong value, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- Client ----------
# docker-compose sets this for the client service; listed here for reference
# (and for running the client outside Docker).
VITE_API_URL=http://localhost:8000
