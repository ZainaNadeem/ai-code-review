# Copy to .env and fill in your own values. Do not commit .env.
# Example placeholders — set these yourself, never commit real secrets.
APP_ENV=development
LOG_LEVEL=info

# PostgreSQL connection string.
# When running via docker compose, use host "db"; for local runs use "localhost".
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_code_review

# Add your provider keys locally, e.g.:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
