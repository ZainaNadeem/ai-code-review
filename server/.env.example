# Copy to .env and fill in your own values. Do not commit .env.
# Example placeholders — set these yourself, never commit real secrets.
APP_ENV=development
LOG_LEVEL=info

# PostgreSQL connection string.
# When running via docker compose, use host "db"; for local runs use "localhost".
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_code_review

# Secret shared with the GitHub webhook (Settings → Webhooks → Secret).
# Used to verify the HMAC-SHA256 signature of incoming webhook payloads.
GITHUB_WEBHOOK_SECRET=

# GitHub personal access token used to fetch PR diffs via the API.
# Needs "repo" (or read-only "pull requests") scope. Required for private repos.
GITHUB_TOKEN=

# OpenAI API key used by the review pipeline. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
